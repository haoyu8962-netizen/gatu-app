[Unit]
Description=gatu — Hyperliquid trading terminal (TanStack Start SSR)
Documentation=https://github.com/zora4523-bot/gatu-app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gatu
Group=gatu
# Run the immutable Nitro release pointed to by /opt/gatu/current. The deploy
# script builds in the repo, copies .output to /opt/gatu/releases/<stamp>-<sha>,
# then atomically switches this symlink before restarting the service.
WorkingDirectory=/opt/gatu/current
# Runtime-only env: PORT, HOST, IPDATA_API_KEY. NOT the VITE_* vars (those are baked
# into the client bundle at build time and are not read here).
EnvironmentFile=/opt/gatu/shared/.env.runtime
Environment=NODE_ENV=production
# Canonical releases carry identity markers, one exact capability token, and the
# guard itself. Markerless releases are the narrowly scoped legacy rollback path.
# systemd turns each $$ below into the literal $ required by /bin/sh command substitution.
ExecStart=/bin/sh -ec 'if [ "$${HOST:-}" != "127.0.0.1" ] || [ "$${NITRO_HOST:-127.0.0.1}" != "127.0.0.1" ] || [ "$${PORT:-3000}" != "3000" ] || [ "$${NITRO_PORT:-3000}" != "3000" ]; then echo "ERROR: runtime listener must be 127.0.0.1:3000" >&2; exit 1; fi; export PORT=3000 NITRO_PORT=3000; if [ -e .gatu-release-commit ] || [ -e .gatu-release-id ] || [ -e .gatu-release-capabilities ]; then if [ ! -f .gatu-release-commit ] || [ -L .gatu-release-commit ] || [ ! -f .gatu-release-id ] || [ -L .gatu-release-id ] || [ ! -f .gatu-release-capabilities ] || [ -L .gatu-release-capabilities ] || [ ! -f ./referral-uri-guard.cjs ] || [ -L ./referral-uri-guard.cjs ] || [ "$$(/usr/bin/wc -c < .gatu-release-capabilities)" -ne 17 ] || [ "$$(/usr/bin/cat .gatu-release-capabilities)" != "referral-join-v1" ]; then echo "ERROR: identified release is missing the exact referral-join-v1 capability or guard" >&2; exit 1; fi; exec /usr/bin/node --require=./referral-uri-guard.cjs server/index.mjs; fi; exec /usr/bin/node server/index.mjs'
Restart=on-failure
RestartSec=3

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gatu

[Install]
WantedBy=multi-user.target
