# RUNTIME environment — copy to /opt/gatu/shared/.env.runtime on the host.
#
# Loaded by systemd (EnvironmentFile) into the running node-server process.
# Format: KEY=value, one per line, NO quotes and NO `export`.
# These are server-side only — they are NOT exposed to the browser.

# Port the Nitro node-server listens on. Caddy reverse-proxies to this port.
PORT=3000

# Bind to loopback only — Caddy (same host) is the sole front door, so the node
# process is never directly reachable from the internet.
HOST=127.0.0.1

# Public origins served by the same Caddy virtual host and Node release.
# deploy.sh checks both origins, their /join deep links, and release parity.
GATU_MAINNET_PUBLIC_BASE_URL=https://app.gatu.ai
GATU_TESTNET_PUBLIC_BASE_URL=https://testnet.gatu.ai

# Deployment acknowledgement for the mainnet CCTP build gates. Keep the
# template fail-closed. Set to sponsored-only on the production host only when
# VITE_CCTP_SPONSORED_DEPOSIT_MAINNET_ENABLED=true and the external gate is
# empty. Set back to disabled for an emergency stop build.
GATU_CCTP_MAINNET_RELEASE_MODE=disabled

# IPdata API key — server-side jurisdiction / VPN checks for geo-restricted
# trading. From https://dashboard.ipdata.co. Browsing falls back to an unknown
# location without it, while Referral mutations fail closed. Rotate any key
# that was previously shared outside the deployment secret store.
IPDATA_API_KEY=
