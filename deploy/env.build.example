# BUILD-TIME environment — copy to apps/terminal/.env.local on the machine that
# runs `pnpm build` for a CloudFront release (see deploy/cloudfront/README.md).
#
# These VITE_* values are read by Vite during `pnpm build` and are BAKED INTO the
# client JS bundle. Everything here ships to browsers and is therefore PUBLIC —
# never put a server secret in this file. Changing any value requires a rebuild.

# Privy App ID — from https://dashboard.privy.io (App settings). Public by design.
VITE_PRIVY_APP_ID=

# Leave UNSET for mainnet. Set to "true" only for a testnet build.
VITE_HYPERLIQUID_TESTNET=

# Stable production Agent slot. Local development defaults to `gatu-dev`;
# non-production mainnet builds must use their own explicit slot instead of
# replacing the production Agent with a same-name approval.
VITE_HYPERLIQUID_AGENT_NAME=gatu

# Optional: custom Ethereum mainnet RPC for LiFi bridging.
VITE_ETHEREUM_RPC_URL=

# The compact order book uses Hyperliquid's undocumented incremental `l2`
# channel by default. Emergency rollback: set the exact string "false", then
# rebuild and deploy, to restore the public five-level `l2Book + fast` feed.
VITE_COMPACT_ORDERBOOK_L2_ENABLED=

# Mobile Agent QR pairing is fail-closed. This is a build-time rollout gate: use
# the exact string "true" to enable the desktop Link mobile device icon and the
# phone import page together, then rebuild and deploy. Keep it off until the
# physical-device checklist is recorded; `deploy.mjs sync --execute` refuses a
# build with the flag on unless --allow-mobile-pairing is passed.
VITE_MOBILE_PAIRING_ENABLED=

# Direct external-wallet CCTP deposits on Mainnet are always enabled in code.
# Testnet and sponsored paths remain explicit fail-closed rollout gates. Every
# gate change requires a rebuild. The build records the effective values in
# build-meta.json, and `deploy.mjs sync --execute` refuses a build that exposes
# sponsored Mainnet deposits without --allow-sponsored-mainnet-deposits
# (docs/cctp-deposits.md, deploy/cloudfront/README.md).
VITE_PORTFOLIO_MARGIN_ACTIVATION_ENABLED=
VITE_LIFI_BRIDGE_CREATE_ENABLED=
VITE_CCTP_EXTERNAL_DEPOSIT_TESTNET_ENABLED=
VITE_CCTP_SPONSORED_DEPOSIT_MAINNET_ENABLED=
VITE_CCTP_SPONSORED_DEPOSIT_TESTNET_ENABLED=
