# /etc/caddy/Caddyfile — gatu single-host reverse proxy + automatic HTTPS.
#
# Caddy obtains and renews a Let's Encrypt certificate for this domain
# automatically. Requirements:
#   - DNS A record  app.gatu.ai → this host's public IP
#   - inbound ports 80 and 443 open in the security group
#
# Replace the domain below if you serve on a different hostname.

app.gatu.ai {
	encode zstd gzip

	# The application build assets are content-hashed and safe to cache indefinitely.
	@immutable path /assets/*
	header @immutable >Cache-Control "public, max-age=31536000, immutable"

	# Charting Library v28 can stall during repeated WebKit loads when its scripts
	# are reused from a hot immutable cache. Revalidate the complete chart package.
	@chart_assets path /charting_library/* /tradingview-theme.css
	header @chart_assets >Cache-Control "public, max-age=0, must-revalidate"

	# Nitro route rules emit the path-specific Content-Security-Policy and related
	# application headers. Do not add a second CSP here: browsers enforce every CSP
	# response header, so an uncoordinated proxy policy can break the terminal or chart iframe.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/gatu.access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}
