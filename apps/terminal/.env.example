# Copy to .env.local and fill in. All VITE_* vars are PUBLIC (bundled into the
# client build) — never put server secrets (e.g. a Privy App secret) in here.

# Privy App ID — from https://dashboard.privy.io (App settings). Public by design.
VITE_PRIVY_APP_ID=

# Use Hyperliquid testnet instead of mainnet ("true" | unset).
VITE_HYPERLIQUID_TESTNET=

# Optional: custom Ethereum mainnet RPC for LiFi bridging.
VITE_ETHEREUM_RPC_URL=

# Optional: enable render performance profiling in dev.
VITE_PERF_ENABLED=

# The compact order book uses Hyperliquid's undocumented incremental `l2`
# channel by default. Set this to the exact string "false", then rebuild and
# deploy, to roll back to the public five-level `l2Book + fast` feed.
VITE_COMPACT_ORDERBOOK_L2_ENABLED=

# Mobile Agent credential transfer is fail-closed. Set each flag to the exact
# string "true" and rebuild/deploy to enable QR pairing: the desktop Link mobile
# device icon and the phone import page appear together, never one without the other.
VITE_MOBILE_PAIRING_ENABLED=

# High-risk trading capabilities are independently fail-closed. Set only the
# intended gate to the exact string "true", then rebuild and deploy.
VITE_PORTFOLIO_MARGIN_ACTIVATION_ENABLED=
VITE_LIFI_BRIDGE_CREATE_ENABLED=

# Direct external-wallet CCTP deposits on Mainnet are always enabled in code.
# Testnet and sponsored paths remain explicit build gates. Sponsored deposits
# use the exact Privy embedded EOA for the EIP-3009 authorization and the Privy
# Smart Wallet Paymaster/Bundler to submit.
VITE_CCTP_EXTERNAL_DEPOSIT_TESTNET_ENABLED=
VITE_CCTP_SPONSORED_DEPOSIT_MAINNET_ENABLED=
VITE_CCTP_SPONSORED_DEPOSIT_TESTNET_ENABLED=

# --- Server-side only (NO VITE_ prefix → not exposed to the client) ---

# IPdata API key — from https://dashboard.ipdata.co. Used server-side for jurisdiction /
# VPN checks (geo-restricted trading). In production, set this in your host/AWS env.
# Local development defaults to GB because loopback/private IPs cannot be geolocated;
# use ?geo=US or ?geo=CA-ON to exercise restricted states.
IPDATA_API_KEY=
