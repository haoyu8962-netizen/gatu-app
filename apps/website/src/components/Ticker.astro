---
const items = [
	{ symbol: "BTC", coin: "BTC", tag: "PERP" },
	{ symbol: "ETH", coin: "ETH", tag: "PERP" },
	{ symbol: "SOL", coin: "SOL", tag: "PERP" },
	{ symbol: "HYPE", coin: "HYPE", tag: "PERP" },
	{ symbol: "TSLA", coin: "xyz:TSLA", tag: "EQUITY" },
	{ symbol: "NVDA", coin: "xyz:NVDA", tag: "EQUITY" },
	{ symbol: "AAPL", coin: "xyz:AAPL", tag: "EQUITY" },
	{ symbol: "SILVER", coin: "xyz:SILVER", tag: "METAL" },
	{ symbol: "JP225", coin: "xyz:JP225", tag: "INDEX" },
];
---

<div class="border-b border-stroke-weaker bg-surface/40" aria-hidden="true">
	<div class="marquee mx-auto max-w-6xl overflow-hidden">
		<div class="marquee-track flex w-max items-center gap-10 px-6 py-2.5">
			{[0, 1].map((copy) => (
				<div class="flex items-center gap-10" data-marquee-copy={copy}>
					{items.map((item) => (
						<span class="inline-flex items-center gap-2 text-2xs whitespace-nowrap">
							<span class="text-3xs uppercase tracking-uppercase text-fg-faint">{item.tag}</span>
							<span class="font-medium text-fg-muted">{item.symbol}</span>
							<span class="tabular-nums text-fg" data-hl-price={item.coin}>—</span>
						</span>
					))}
				</div>
			))}
		</div>
	</div>
</div>

<script>
	const PERP_URL = "https://api.hyperliquid.xyz/info";

	function formatPrice(raw: string): string {
		const value = Number(raw);
		if (!Number.isFinite(value)) return "—";
		if (value >= 1000) return value.toLocaleString("en-US", { maximumFractionDigits: 0 });
		if (value >= 10) return value.toFixed(2);
		if (value >= 0.1) return value.toFixed(4);
		return value.toFixed(6);
	}

	async function fetchMids(dex?: string): Promise<Record<string, string>> {
		const response = await fetch(PERP_URL, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(dex ? { type: "allMids", dex } : { type: "allMids" }),
		});
		if (!response.ok) throw new Error(String(response.status));
		return response.json();
	}

	async function fillPrices() {
		const nodes = document.querySelectorAll<HTMLElement>("[data-hl-price]");
		if (nodes.length === 0) return;
		try {
			const [main, xyz] = await Promise.all([fetchMids(), fetchMids("xyz").catch(() => ({}))]);
			const mids: Record<string, string> = { ...main, ...xyz };
			for (const node of nodes) {
				const coin = node.dataset.hlPrice;
				if (coin && mids[coin]) node.textContent = formatPrice(mids[coin]);
			}
		} catch {
			/* leave placeholders on failure */
		}
	}

	fillPrices();
</script>
