---
import vaultIcon from "@phosphor-icons/core/assets/regular/vault.svg?raw";
import signatureIcon from "@phosphor-icons/core/assets/regular/signature.svg?raw";
import stackIcon from "@phosphor-icons/core/assets/regular/stack.svg?raw";
import { BRAND_NAME } from "@/config/brand";
import { HL_ORDER_BOOK_DOCS_URL } from "@/config/copy";

// Review 2026-10-26 item 3: the short version of #security, early on the page. It describes the interface
// relationship only; it never calls the brand a protocol, an exchange or decentralised.
const points = [
	{
		title: "Funds in your own account",
		desc: `Your funds stay in your own Hyperliquid account. ${BRAND_NAME} is non-custodial and never takes custody of them.`,
		icon: vaultIcon,
		link: null,
	},
	{
		title: "Signed for your account",
		desc: "With email, a wallet created for your account signs your orders; with your own wallet, a trading key you approve signs them. Hyperliquid's on-chain order book matches them.",
		icon: signatureIcon,
		link: null,
	},
	{
		title: "One order book per market",
		desc: `For each market, ${BRAND_NAME} accesses the same order book as other interfaces connected to Hyperliquid. Liquidity differs from market to market.`,
		icon: stackIcon,
		link: { href: HL_ORDER_BOOK_DOCS_URL, label: "How Hyperliquid's order book works →" },
	},
];

function inlineIcon(svg: string, size: number): string {
	return svg.replace("<svg ", `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
}
---

<section id="account" aria-labelledby="account-title">
	<div class="mx-auto grid w-full max-w-site grid-cols-1 gap-6 px-5 pb-14 sm:px-8 md:pb-20 lg:grid-cols-12 lg:gap-10">
		<div class="lg:col-span-4">
			<p class="label">How it works</p>
			<h2 id="account-title" class="mt-4 text-h3 font-medium text-balance">Your account. Hyperliquid execution.</h2>
			<p class="mt-3 max-w-md text-sm text-fg-muted">
				{BRAND_NAME} is the interface; Hyperliquid matches and settles every trade.
				<a href="#security" class="text-fg underline underline-offset-2 hover:text-fg-muted">How your account works ↓</a>
			</p>
		</div>
		<div class="@container lg:col-span-8">
			<ol class="reveal-stagger grid grid-cols-1 gap-3 @cards:grid-cols-3 @cards:gap-4">
				{points.map((point) => (
					<li class="edge edge-raised flex flex-col rounded-24 p-5">
						<span class="text-marketing-accent" set:html={inlineIcon(point.icon, 22)} />
						<h3 class="mt-4 text-base font-medium text-fg">{point.title}</h3>
						<p class="mt-2 text-sm text-fg-muted">{point.desc}</p>
						{point.link && (
							<a href={point.link.href} rel="noopener" class="mt-3 text-sm text-fg underline underline-offset-2 hover:text-fg-muted">
								{point.link.label}
							</a>
						)}
					</li>
				))}
			</ol>
		</div>
	</div>
</section>
