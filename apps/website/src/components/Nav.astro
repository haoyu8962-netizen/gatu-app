---
import { terminalUrl } from "@/lib/terminal-links";
import Logo from "./Logo.astro";

const terminalHref = terminalUrl("/", "header");
const anchors = [
	{ label: "Markets", href: "/#markets" },
	{ label: "Features", href: "/#features" },
	{ label: "Fees", href: "/#fees" },
	{ label: "Security", href: "/#security" },
	{ label: "FAQ", href: "/#faq" },
];
---

<a
	href="#main"
	class="sr-only z-50 rounded-8 bg-action px-4 py-3 text-sm font-medium text-on-action focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
>
	Skip to content
</a>
<header class="site-header sticky top-0 z-40 border-b border-stroke-weaker bg-background/75 backdrop-blur-xl">
	<nav aria-label="Main" class="mx-auto flex h-16 w-full max-w-site items-center justify-between gap-6 px-5 sm:px-8">
		<Logo href="/" />

		<ul class="hidden items-center gap-1 text-sm text-fg-subtle md:flex">
			{anchors.map((anchor) => (
				<li>
					<a href={anchor.href} class="inline-flex h-10 items-center rounded-8 px-3 hover:bg-fill-weaker hover:text-fg">
						{anchor.label}
					</a>
				</li>
			))}
		</ul>

		<a
			href={terminalHref}
			class="press inline-flex h-11 items-center gap-2 rounded-8 bg-action px-4 text-sm font-medium text-on-action hover:bg-action-hover active:bg-action-active md:h-10"
		>
			Open terminal
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
				<path d="M3 9l6-6M5 3h4v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</nav>
</header>
