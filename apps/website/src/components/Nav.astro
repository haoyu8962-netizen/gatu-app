---
import Logo from "./Logo.astro";
const appUrl = "https://app.gatu.ai";
---

<header class="fixed inset-x-0 top-3 md:top-4 z-40 px-4">
	<nav
		class="mx-auto flex h-12 w-full max-w-3xl items-center justify-between rounded-full border border-stroke-weak bg-surface/85 px-2 pl-4 backdrop-blur-md shadow-[0_8px_32px_rgba(0,0,0,0.35)]"
	>
		<Logo size="sm" href="/" />

		<div class="hidden md:flex items-center gap-7 text-xs text-fg-subtle">
			<a href="/#markets" class="hover:text-fg transition-colors duration-200">Markets</a>
			<a href="/#features" class="hover:text-fg transition-colors duration-200">Features</a>
			<a href="/#fees" class="hover:text-fg transition-colors duration-200">Fees</a>
			<a href="/#faq" class="hover:text-fg transition-colors duration-200">FAQ</a>
		</div>

		<a
			href={appUrl}
			class="press inline-flex h-8 items-center gap-1.5 rounded-full bg-brand px-3.5 text-xs font-medium text-fg-inverse hover:opacity-90 transition-opacity duration-200"
		>
			Open terminal
			<svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
				<path d="M3 9l6-6M5 3h4v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</nav>
</header>
<div class="h-[72px] md:h-20" aria-hidden="true"></div>
