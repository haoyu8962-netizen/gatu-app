---
import { terminalUrl } from "@/lib/terminal-links";
import ButtonLink from "./ButtonLink.astro";
import Logo from "./Logo.astro";

const terminalHref = terminalUrl("/", "header");
const anchors = [
	{ label: "Markets", href: "/#markets" },
	{ label: "Features", href: "/#features" },
	{ label: "Fees", href: "/#fees" },
	{ label: "Security", href: "/#security" },
	{ label: "FAQ", href: "/#faq" },
];
---

<ButtonLink href="#main" variant="primary" size="md" icon="none" class="skip-link">Skip to content</ButtonLink>
<header class="site-header sticky top-0 z-40 border-b border-stroke-weaker bg-background/75 backdrop-blur-xl">
	<nav aria-label="Main" class="mx-auto flex h-16 w-full max-w-site items-center justify-between gap-6 px-5 sm:px-8">
		<Logo href="/" />

		<ul class="hidden items-center gap-1 text-sm text-fg-subtle md:flex">
			{anchors.map((anchor) => (
				<li>
					<a href={anchor.href} class="inline-flex h-10 items-center rounded-8 px-3 hover:bg-fill-weaker hover:text-fg">
						{anchor.label}
					</a>
				</li>
			))}
		</ul>

		<ButtonLink href={terminalHref} variant="primary" size="md" icon="external">Open terminal</ButtonLink>
	</nav>
</header>
