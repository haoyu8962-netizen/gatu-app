---
const markets = [
	{ symbol: "TSLA", coin: "xyz:TSLA", name: "Tesla", tag: "Equity perp" },
	{ symbol: "NVDA", coin: "xyz:NVDA", name: "NVIDIA", tag: "Equity perp" },
	{ symbol: "AAPL", coin: "xyz:AAPL", name: "Apple", tag: "Equity perp" },
	{ symbol: "JP225", coin: "xyz:JP225", name: "Nikkei 225", tag: "Index perp" },
	{ symbol: "SILVER", coin: "xyz:SILVER", name: "Silver", tag: "Metal perp" },
	{ symbol: "BTC", coin: "BTC", name: "Bitcoin", tag: "Crypto perp" },
	{ symbol: "ETH", coin: "ETH", name: "Ethereum", tag: "Crypto perp" },
	{ symbol: "HYPE", coin: "HYPE", name: "Hyperliquid", tag: "Crypto perp" },
];

const points = [
	{
		title: "Around the clock",
		body: "Equity and index perps don't close with the exchange bell — manage exposure nights and weekends.",
	},
	{
		title: "Your wallet is the account",
		body: "No brokerage onboarding, no transfer delays. Connect, fund, trade — all onchain.",
	},
	{
		title: "Perps, not securities",
		body: "These are perpetual futures tracking the underlying price, with the same margin engine as every other market.",
	},
];
---

<section id="markets" class="border-b border-stroke-weaker">
	<div class="reveal mx-auto w-full max-w-5xl px-6 py-20 md:py-28">
		<div class="text-center">
			<span class="text-3xs uppercase tracking-uppercase text-fg-faint">Markets</span>
			<h2 class="mt-3 text-xl md:text-2xl font-medium tracking-display">
				Stocks, indices, metals, crypto — <span class="text-brand-gradient">one venue</span>.
			</h2>
			<p class="mt-4 mx-auto max-w-lg text-sm text-fg-muted leading-relaxed">
				Trade TSLA, NVDA, and AAPL perps next to BTC and HYPE — live prices below are streamed straight from
				Hyperliquid, the same source the terminal uses.
			</p>
		</div>

		<div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-px bg-stroke-weaker rounded-xs overflow-hidden border border-stroke-weak">
			{markets.map((m) => (
				<div class="bg-surface p-5 hover:bg-fill-weaker transition-colors duration-200">
					<div class="flex items-baseline justify-between gap-2">
						<span class="text-sm font-medium">{m.symbol}</span>
						<span class="text-3xs uppercase tracking-uppercase text-fg-faint whitespace-nowrap">{m.tag}</span>
					</div>
					<div class="mt-2 text-lg font-medium tabular-nums" data-hl-price={m.coin}>—</div>
					<div class="mt-1 text-2xs text-fg-faint">{m.name}</div>
				</div>
			))}
		</div>

		<div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
			{points.map((p) => (
				<div>
					<div class="text-sm font-medium">{p.title}</div>
					<p class="mt-1.5 text-xs text-fg-muted leading-relaxed">{p.body}</p>
				</div>
			))}
		</div>
	</div>
</section>
