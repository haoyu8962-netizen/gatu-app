---
import { BRAND_NAME } from "@/config/brand";
import { formatIsoDate, HIP3_DOCS_URL, joinNames, RISK_PATH, RISK_SENTENCE } from "@/config/copy";
import { formatCompactUsd } from "@/lib/markets/live.js";
import type { CategoryCard } from "@/lib/markets/rules";
import {
	getCategoryCards,
	getDeployers,
	getPreIpoRows,
	type PreIpoRow,
	SNAPSHOT_FETCHED_AT,
} from "@/lib/markets/structure";
import { terminalTradeUrl } from "@/lib/terminal-links";

const CATEGORY_LABELS: Record<CategoryCard, string> = {
	crypto: "Crypto",
	stocks: "Stocks",
	indices: "Indices",
	commodities: "Commodities",
	fx: "FX",
	preipo: "Pre-IPO",
	rates: "Rates",
};

const cards = getCategoryCards(4);
const preIpoRows = getPreIpoRows();
const allDeployers = joinNames(getDeployers().map((deployer) => deployer.fullName));
const snapshotDate = formatIsoDate(SNAPSHOT_FETCHED_AT);

const settlementByDeployer = new Map<string, boolean>();
for (const row of preIpoRows) {
	if (!row.preIpoTerms || !row.deployerFullName) continue;
	const earlier = settlementByDeployer.get(row.deployerFullName) ?? true;
	settlementByDeployer.set(row.deployerFullName, earlier && row.preIpoTerms.earlySettlementOnNotice);
}
const settlementSentences = [...settlementByDeployer].map(([deployer, onNotice]) => ({
	deployer,
	text: onNotice
		? "If the company does not list by the scheduled date, or earlier if the deployer gives notice, the market is settled."
		: "If the company does not list by the scheduled date, the market is settled.",
}));

function rowNotes(row: PreIpoRow): string[] {
	const notes: string[] = [];
	if (row.onlyIsolated) notes.push("Isolated margin only");
	if (row.preIpoTerms) notes.push(`Settlement scheduled for ${formatIsoDate(row.preIpoTerms.scheduledSettlement)}`);
	return notes;
}

const LG_LAST_CARD_SPAN = ["lg:col-span-1", "lg:col-span-3", "lg:col-span-2"];

function lastCardSpan(count: number): string {
	const small = count % 2 === 1 ? "sm:col-span-2" : "sm:col-span-1";
	return `${small} ${LG_LAST_CARD_SPAN[count % 3]}`;
}

function marketCountLabel(count: number): string {
	return count === 1 ? "1 market" : `${count} markets`;
}
---

<section id="markets" class="border-b border-stroke-weaker">
	<div class="reveal mx-auto w-full max-w-6xl px-5 sm:px-6 py-20 md:py-28">
		<div class="text-center">
			<span class="text-3xs uppercase tracking-uppercase text-fg-faint">Markets</span>
			<h2 class="font-display mt-3 text-xl md:text-2xl tracking-display">
				Every market, <span class="text-signal">one account</span>
			</h2>
			<p class="mt-4 mx-auto max-w-lg text-sm text-fg-muted leading-relaxed">
				Trade 24/7 across crypto and traditional markets from one account.
			</p>
		</div>

		<ul class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-stroke-weaker rounded-xs overflow-hidden border border-stroke-weak">
			{cards.map((card, index) => (
				<li class:list={["flex flex-col bg-surface p-5 md:p-6", index === cards.length - 1 && lastCardSpan(cards.length)]}>
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="text-sm font-medium">{CATEGORY_LABELS[card.category]}</h3>
						<span class="text-2xs tabular-nums text-fg-faint whitespace-nowrap">{marketCountLabel(card.listedCount)}</span>
					</div>
					{card.category === "crypto" && <p class="mt-1 text-2xs text-fg-subtle">Spot in the same workspace</p>}
					<ul class="mt-4 space-y-1.5 text-xs">
						{card.examples.map((market) => (
							<li data-market-coin={market.coin}>
								<a
									href={terminalTradeUrl(market.coin, `markets_${card.category}`)}
									class="group inline-flex flex-wrap items-baseline gap-x-1.5 hover:text-fg"
								>
									<span class="text-fg group-hover:underline underline-offset-2">{market.name}</span>
									{market.deployerFullName && <span class="text-fg-faint">by {market.deployerFullName}</span>}
								</a>
							</li>
						))}
					</ul>
					{card.deployers.length > 0 && (
						<p class="mt-auto pt-4 text-2xs text-fg-subtle">Run by {joinNames(card.deployers)}</p>
					)}
				</li>
			))}
		</ul>
		<p class="mt-3 text-2xs text-fg-faint">
			Markets not delisted on Hyperliquid as of {snapshotDate} (UTC), from a snapshot taken before this page was built.
		</p>

		<div class="mt-12 rounded-xs border border-stroke-weak bg-surface p-5 md:p-7">
			<h3 class="text-sm font-medium">Pre-IPO perpetuals</h3>
			<p class="mt-2 text-sm text-fg-muted leading-relaxed">
				Pre-IPO perpetuals are cash-settled contracts that track a reference price set by the deployer. They are not
				shares and not an IPO allocation, and they give you no rights in the company.
			</p>
			{settlementSentences.map((sentence) => (
				<p class="mt-2 text-sm text-fg-muted leading-relaxed">
					<span class="text-fg">{sentence.deployer}:</span> {sentence.text}
				</p>
			))}

			<ul class="mt-5 divide-y divide-stroke-weaker border-y border-stroke-weaker">
				{preIpoRows.map((row) => (
					<li class="grid grid-cols-1 gap-1 py-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-baseline md:gap-6" data-market-coin={row.coin}>
						<div class="text-xs leading-relaxed">
							<a
								href={terminalTradeUrl(row.coin, "markets_preipo")}
								class="text-sm font-medium text-fg underline-offset-2 hover:underline"
							>{row.name}</a>
							<span class="text-fg-faint"> · by {row.deployerFullName}</span>
							{row.quotedPerShare && <span class="block text-fg-muted">Quoted per share of the company</span>}
							{row.preIpoTerms && (
								<span class="block text-fg-muted">
									Unit: each US$1 of price is US${formatCompactUsd(row.preIpoTerms.valuationPerPriceUsd)} of implied valuation
								</span>
							)}
							{rowNotes(row).length > 0 && <span class="block text-fg-subtle">{rowNotes(row).join(" · ")}</span>}
						</div>
						<a
							href={row.preIpoTerms ? row.preIpoTerms.unitSource.url : row.docsUrl}
							rel="noopener"
							class="text-xs text-fg-muted underline underline-offset-2 hover:text-fg whitespace-nowrap"
						>
							{row.preIpoTerms ? "How the price is set →" : "Deployer documentation →"}
						</a>
					</li>
				))}
			</ul>
		</div>

		<div class="mt-12 mx-auto max-w-3xl">
			<p class="text-sm md:text-base text-fg-muted leading-relaxed">
				Stocks, indices, commodities, FX and pre-IPO markets are HIP-3 perpetuals deployed on Hyperliquid by independent
				third parties: {allDeployers}. Each deployer defines its markets, sets the reference price and can halt, settle or
				delist a market. Hyperliquid matches and settles trades; {BRAND_NAME} is the interface and does not review these
				markets. Outside a stock's exchange hours, prices come from the deployer's own mechanism. These contracts give
				you no ownership, dividend or voting rights, and {BRAND_NAME} is not affiliated with the companies they
				reference.
				<a href={HIP3_DOCS_URL} rel="noopener" class="text-fg underline underline-offset-2 hover:text-fg-muted transition-colors duration-150">How HIP-3 works →</a>
			</p>
			<p class="mt-4 text-sm md:text-base text-fg-muted leading-relaxed">
				{RISK_SENTENCE}
				<a href={RISK_PATH} class="text-fg underline underline-offset-2 hover:text-fg-muted transition-colors duration-150">Risk disclosure →</a>
			</p>
		</div>
	</div>
</section>
