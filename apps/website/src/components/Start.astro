---
import { RISK_PATH, RISK_SENTENCE } from "@/config/copy";
import { terminalTradeUrl } from "@/lib/terminal-links";
import SectionHeader from "./SectionHeader.astro";

const startUrl = terminalTradeUrl("BTC", "start_cta");
const steps = [
	{
		title: "Sign in with email or your own wallet.",
		note: "With email, a wallet created for your account signs your orders. With your own wallet, you approve a trading key for this browser session instead of signing every order; it is kept after a restart only if you choose to stay connected.",
	},
	{ title: "Deposit USDC on Arbitrum.", note: null },
	{ title: "Place your first order.", note: null },
];
---

<section id="start" class="band">
	<div class="mx-auto w-full max-w-site px-5 py-16 sm:px-8 md:py-24">
		<div class="reveal">
			<SectionHeader label="Get started">Start in three steps</SectionHeader>
		</div>

		<ol class="reveal mt-10 grid grid-cols-1 gap-4 md:mt-12 lg:grid-cols-3">
			{steps.map((step, index) => (
				<li class="edge edge-panel flex flex-col rounded-24 p-6 shadow-card md:p-8">
					<span class="font-mono text-stat text-fg-faint" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
					<h3 class="mt-6 text-h3 font-medium md:mt-8">{step.title}</h3>
					{step.note && <p class="mt-3 text-sm text-fg-muted">{step.note}</p>}
				</li>
			))}
		</ol>

		<p class="reveal mt-6 text-base text-fg-muted">
			<span class="text-fg">Already use Hyperliquid?</span> Connect the same wallet to reach your existing account.
		</p>

		<div data-cta-group class="reveal mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
			<a
				href={startUrl}
				class="press inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-8 bg-action px-6 text-base font-medium text-on-action hover:bg-action-hover active:bg-action-active"
			>
				Start trading
				<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<path d="M3 9l6-6M5 3h4v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
			<p class="text-sm text-fg-muted">
				{RISK_SENTENCE}
				<a href={RISK_PATH} class="text-fg underline underline-offset-2 hover:text-fg-muted">Risk disclosure →</a>
			</p>
		</div>
	</div>
</section>
