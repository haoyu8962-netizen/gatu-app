---
import translateIcon from "@phosphor-icons/core/assets/regular/translate.svg?raw";
import envelopeIcon from "@phosphor-icons/core/assets/regular/envelope-simple.svg?raw";
import targetIcon from "@phosphor-icons/core/assets/regular/target.svg?raw";
import layoutIcon from "@phosphor-icons/core/assets/regular/layout.svg?raw";
import phoneIcon from "@phosphor-icons/core/assets/regular/device-mobile.svg?raw";
import plusIcon from "@phosphor-icons/core/assets/regular/plus-circle.svg?raw";
import languageAvif from "@/assets/features/language.avif";
import languageWebp from "@/assets/features/language.webp";
import emailAvif from "@/assets/features/email.avif";
import emailWebp from "@/assets/features/email.webp";
import tpslAvif from "@/assets/features/tpsl.avif";
import tpslWebp from "@/assets/features/tpsl.webp";
import workspaceAvif from "@/assets/features/workspace.avif";
import workspaceWebp from "@/assets/features/workspace.webp";
import phoneAvif from "@/assets/features/phone.avif";
import phoneWebp from "@/assets/features/phone.webp";
import moreAvif from "@/assets/features/more.avif";
import moreWebp from "@/assets/features/more.webp";
import record from "@/assets/features/features-capture.json";
import { APP_HOST } from "@/config/brand";
import { formatUtcTimestamp } from "@/config/copy";
import SectionHeader from "./SectionHeader.astro";

type Fit = "screen" | "portrait" | "detail" | "strip";

// Plan §4 04: benefit titles; the first card is the verified differentiator. Each tab shows one real,
// signed-out screenshot captured by scripts/capture-features.mjs and encoded by scripts/optimize-images.mjs
// ("detail": the encoder keeps only the top of the Arabic phone capture, shown large enough to read).
const features = [
	{
		id: "language",
		title: "Trade in your language",
		desc: "English, 简体中文, हिन्दी, Español, Français and العربية, with a right-to-left layout for Arabic.",
		icon: translateIcon,
		avif: languageAvif,
		webp: languageWebp,
		fit: "detail" as Fit,
	},
	{
		id: "email",
		title: "No wallet? Use your email.",
		desc: "Sign in with email and start without installing a wallet, or connect the wallet you already use.",
		icon: envelopeIcon,
		avif: emailAvif,
		webp: emailWebp,
		fit: "portrait" as Fit,
	},
	{
		id: "tpsl",
		title: "Set TP/SL as you enter",
		desc: "Market, limit, stop, take-profit, TWAP and scale orders on perpetuals.",
		icon: targetIcon,
		avif: tpslAvif,
		webp: tpslWebp,
		fit: "portrait" as Fit,
	},
	{
		id: "workspace",
		title: "Everything in one workspace",
		desc: "Perpetuals and spot side by side, with charts, order book and recent trades.",
		icon: layoutIcon,
		avif: workspaceAvif,
		webp: workspaceWebp,
		fit: "screen" as Fit,
	},
	{
		id: "phone",
		title: "Trade from your phone",
		desc: "A dedicated mobile layout that you can install as an app.",
		icon: phoneIcon,
		avif: phoneAvif,
		webp: phoneWebp,
		fit: "portrait" as Fit,
	},
	{
		id: "more",
		title: "More in the terminal",
		desc: "Earn, vaults, staking, referrals and a leaderboard.",
		icon: plusIcon,
		avif: moreAvif,
		webp: moreWebp,
		fit: "strip" as Fit,
	},
];

const captures = record.captures as Record<string, { capturedAt: string; alt: string; viewport: { width: number } }>;
const visuals = features.map((feature) => {
	const capture = captures[feature.id];
	if (!capture) throw new Error(`features-capture.json has no ${feature.id} capture`);
	return {
		...feature,
		alt: capture.alt,
		caption: `Screenshot of ${APP_HOST}, signed out · ${formatUtcTimestamp(capture.capturedAt)}`,
	};
});

function inlineIcon(svg: string, size: number): string {
	return svg.replace("<svg ", `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
}

const imageClass: Record<Fit, string> = {
	screen: "h-full w-full object-cover object-left-top",
	portrait: "h-[165%] w-auto max-w-none shrink-0 rounded-16 border border-stroke-weak shadow-card",
	detail: "h-[125%] w-auto max-w-none shrink-0 rounded-16 border border-stroke-weak shadow-card",
	strip: "w-full h-auto rounded-16 border border-stroke-weak shadow-card",
};
const stageClass: Record<Fit, string> = {
	screen: "",
	portrait: "flex items-start justify-center px-6 pt-6 sm:pt-8",
	detail: "flex items-start justify-center px-4 pt-5 sm:pt-8",
	strip: "flex items-center px-4 sm:px-8",
};
---

<section id="features">
	<div class="@container mx-auto w-full max-w-site px-5 py-16 sm:px-8 md:py-24">
		<div class="reveal">
			<SectionHeader label="Features">Built for how you trade</SectionHeader>
		</div>

		<div class="mt-10 grid grid-cols-1 gap-6 md:mt-12 @split:grid-cols-12 @split:gap-10" data-tabs data-tabs-crossfade>
			<div
				role="tablist"
				aria-label="Features"
				data-tablist
				class="reveal-stagger -mx-5 flex gap-2 overflow-x-auto px-5 pb-1 scrollbar-none sm:-mx-8 sm:px-8 @split:mx-0 @split:flex-col @split:self-start @split:overflow-visible @split:px-0 @split:col-span-5"
			>
				{visuals.map((feature, index) => (
					<button
						type="button"
						role="tab"
						id={`feature-tab-${feature.id}`}
						aria-controls={`feature-panel-${feature.id}`}
						aria-selected={index === 0 ? "true" : "false"}
						tabindex={index === 0 ? undefined : "-1"}
						class="feature-tab press flex min-h-11 shrink-0 items-center gap-3 rounded-full border border-transparent px-4 py-2.5 text-left text-sm text-fg-subtle hover:text-fg @split:min-h-14 @split:px-5 @split:text-base"
					>
						<span class="feature-tab-icon inline-flex shrink-0 text-fg-faint" set:html={inlineIcon(feature.icon, 20)} />
						<span class="whitespace-nowrap @split:whitespace-normal">{feature.title}</span>
					</button>
				))}
			</div>

			<div class="reveal @split:col-span-7" data-tab-panels>
				{visuals.map((feature, index) => (
					<div
						id={`feature-panel-${feature.id}`}
						role="tabpanel"
						aria-labelledby={`feature-tab-${feature.id}`}
						data-tabpanel
						data-tabpanel-deferred={index > 0 ? "" : undefined}
						class="flex flex-col"
					>
						<div class="feature-copy grow">
							<h3 class="text-h3 font-medium">{feature.title}</h3>
							<p class="mt-2 max-w-xl text-base text-fg-muted">{feature.desc}</p>
						</div>
						<figure class="mt-6">
							<div class={`surface-dark edge relative isolate aspect-[16/10] overflow-hidden rounded-24 bg-window shadow-card ${stageClass[feature.fit]}`}>
								<div class="hero-ambient opacity-70" aria-hidden="true"></div>
								<picture class="contents">
									<source srcset={feature.avif.src} type="image/avif" />
									<img
										src={feature.webp.src}
										width={feature.webp.width}
										height={feature.webp.height}
										alt={feature.alt}
										loading="lazy"
										decoding="async"
										class={imageClass[feature.fit]}
									/>
								</picture>
							</div>
							<figcaption class="mt-3 font-mono text-xs text-fg-subtle">{feature.caption}</figcaption>
						</figure>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
