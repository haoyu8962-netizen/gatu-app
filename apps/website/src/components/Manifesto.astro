---
const lines = ["No KYC.", "No custody.", "No middlemen."];

function words(line: string, lineIndex: number) {
	return line.split(" ").map((word, wordIndex) => ({
		word,
		delay: lineIndex * 220 + wordIndex * 90,
	}));
}
---

<section class="border-b border-stroke-weaker">
	<div class="reveal word-stagger mx-auto w-full max-w-4xl px-6 py-24 md:py-36 text-center">
		<h2 class="font-display text-2xl md:text-3xl leading-[1.15] tracking-display">
			{lines.map((line, lineIndex) => (
				<>
					{lineIndex > 0 && " "}
					<span class="block">
						{words(line, lineIndex).map(({ word, delay }, wordIndex) => (
							<>
								{wordIndex > 0 && " "}
								<span class="word" style={`transition-delay:${delay}ms`}>{word}</span>
							</>
						))}
					</span>
				</>
			))}
		</h2>
		<p class="mt-6 mx-auto max-w-md text-sm text-fg-muted leading-relaxed">
			Your keys sign, Hyperliquid settles, and a 0.01% builder fee keeps us going. That's the whole arrangement.
		</p>
	</div>
</section>
