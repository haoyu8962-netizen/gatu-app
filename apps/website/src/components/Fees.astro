---
const fees = [
	{ value: "0.015%", label: "Maker fee", note: "paid to the protocol" },
	{ value: "0.045%", label: "Taker fee", note: "paid to the protocol" },
	{ value: "0.01%", label: "Builder fee", note: "funds gatu development" },
];
---

<section id="fees" class="border-b border-stroke-weaker">
	<div class="reveal mx-auto w-full max-w-5xl px-6 py-20 md:py-28">
		<div class="text-center">
			<span class="text-3xs uppercase tracking-uppercase text-fg-faint">Fees</span>
			<h2 class="font-display mt-3 text-xl md:text-2xl tracking-display">Three numbers. That's the whole bill.</h2>
			<p class="mt-4 mx-auto max-w-md text-sm text-fg-muted leading-relaxed">
				No gas per trade, no subscription, no spread markup, no withdrawal ransom.
			</p>
		</div>

		<div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-px bg-stroke-weaker rounded-xs overflow-hidden border border-stroke-weak">
			{fees.map((f) => (
				<div class="bg-surface p-6 md:p-8 text-center">
					<div class="text-2xl md:text-3xl font-medium tabular-nums tracking-tight">{f.value}</div>
					<div class="mt-1 text-2xs uppercase tracking-uppercase text-fg-muted">{f.label}</div>
					<div class="mt-1 text-2xs text-fg-faint">{f.note}</div>
				</div>
			))}
		</div>

		<p class="mt-6 text-center text-2xs text-fg-faint">
			Base tier — protocol fees drop with volume and HYPE staking. Typical centralized exchanges charge ~0.10% taker.
		</p>
	</div>
</section>
