---
interface Props {
	withWordmark?: boolean;
	size?: "sm" | "md";
	href?: string | null;
}

const { withWordmark = true, size = "md", href = "/" } = Astro.props;
const iconSize = size === "sm" ? 22 : 26;
const Tag = href ? "a" : "span";
---

<Tag
	href={href ?? undefined}
	class:list={[
		"inline-flex items-center gap-2.5 text-fg",
		href && "hover:opacity-90 transition",
	]}
>
	<img
		src="/logo.svg"
		width={iconSize}
		height={iconSize}
		class="shrink-0 rounded-4"
		alt=""
		aria-hidden="true"
	/>
	{withWordmark && (
		<span class="text-sm font-bold tracking-tight">
			<span class="text-brand">gatu</span>
		</span>
	)}
</Tag>
