---
interface Props {
	withWordmark?: boolean;
	size?: "sm" | "md";
	href?: string | null;
}

const { withWordmark = true, size = "md", href = "/" } = Astro.props;
const height = size === "sm" ? 16 : 20;
const width = withWordmark ? (size === "sm" ? 72 : 90) : height;
const Tag = href ? "a" : "span";
---

<Tag
	href={href ?? undefined}
	class:list={["inline-flex items-center text-fg", href && "hover:opacity-90 transition"]}
>
	<img
		src={withWordmark ? "/logo.svg" : "/logo-mark.svg"}
		width={width}
		height={height}
		class="h-auto shrink-0"
		alt="GATU"
	/>
</Tag>
