---
import desktopAvif from "@/assets/open-book/btc-desktop.avif";
import desktopWebp from "@/assets/open-book/btc-desktop.webp";
import mobileAvif from "@/assets/open-book/btc-mobile.avif";
import mobileWebp from "@/assets/open-book/btc-mobile.webp";
import poster from "@/assets/open-book/poster.json";
import { formatIsoDate } from "@/config/copy";
import { getFeaturedMarkets } from "@/lib/markets/structure";
import { MAX_LEVELS, N_SIG_FIGS as SIG_FIGS } from "@/scripts/open-book";

const coin = poster.coin;
const market = getFeaturedMarkets().find((entry) => entry.coin === coin);
if (!market) throw new Error(`the Open Book coin ${coin} is not a featured market`);

function hhmm(iso: string): string {
	return iso.slice(11, 16);
}
const recordedNote = `Recorded ${formatIsoDate(poster.recordedFrom)}, ${hhmm(poster.recordedFrom)}–${hhmm(poster.recordedTo)} UTC.`;
const stats = [
	{ label: "Best bid", slot: "data-ob-bid" },
	{ label: "Best ask", slot: "data-ob-ask" },
	{ label: "Spread", slot: "data-ob-spread" },
	{ label: "Last trade", slot: "data-ob-last" },
];
---

<div
	class="open-book flex flex-col"
	data-open-book
	data-coin={coin}
	data-sz-decimals={market.szDecimals}
	data-recorded-note={recordedNote}
	data-phase="recorded"
	aria-busy="true"
>
	<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 pt-3 pb-3 sm:px-5">
		<p class="font-mono text-xs text-fg-subtle">
			<span class="text-fg">{coin} order-book activity</span> · Hyperliquid public data · not a terminal feature
		</p>
		<div class="flex items-center gap-2">
			<span class="rounded-full border border-stroke-weak px-2.5 py-0.5 font-mono text-2xs uppercase tracking-label text-fg-muted" data-ob-state>
				Recorded
			</span>
			<button
				type="button"
				data-ob-pause
				aria-pressed="false"
				hidden
				class="press inline-flex min-h-11 items-center rounded-8 border border-stroke-weak px-3 font-mono text-xs text-fg-muted hover:border-stroke-strong hover:text-fg active:bg-fill-weak sm:min-h-8"
			>
				Pause
			</button>
		</div>
	</div>

	<div class="relative aspect-[15/16] w-full overflow-hidden bg-window sm:aspect-[13/7]">
		<picture data-ob-poster class="absolute inset-0 block">
			<source media="(min-width: 640px)" srcset={desktopAvif.src} type="image/avif" />
			<source media="(min-width: 640px)" srcset={desktopWebp.src} type="image/webp" />
			<source srcset={mobileAvif.src} type="image/avif" />
			<img
				src={mobileWebp.src}
				width={mobileWebp.width}
				height={mobileWebp.height}
				alt={`Recorded ${coin} order-book activity: resting orders over two minutes with trades and the mid price, on a price scale and a time scale. ${recordedNote}`}
				loading="lazy"
				decoding="async"
				class="h-full w-full object-cover"
			/>
		</picture>
		<canvas data-ob-canvas aria-hidden="true" hidden class="absolute inset-0 block h-full w-full"></canvas>
		<button
			type="button"
			data-ob-start
			hidden
			class="press absolute right-4 bottom-4 inline-flex min-h-11 items-center rounded-8 bg-action px-4 text-sm font-medium text-on-action hover:bg-action-hover active:bg-action-active"
		>
			Show live view
		</button>
	</div>

	<dl class="grid grid-cols-2 border-t border-stroke-weaker sm:grid-cols-4">
		{stats.map((stat) => (
			<div class="flex flex-col gap-1 border-stroke-weaker px-4 py-3 odd:border-r sm:border-r sm:px-5 sm:last:border-r-0 max-sm:[&:nth-child(-n+2)]:border-b">
				<dt class="label">{stat.label}</dt>
				<dd class="h-6 font-mono text-base text-fg" {...{ [stat.slot]: "" }}></dd>
			</div>
		))}
	</dl>
	<div class="flex flex-col gap-3 border-t border-stroke-weaker px-4 py-4 sm:px-5">
		<p class="min-h-8 text-sm text-fg-muted sm:min-h-5" data-ob-note>{recordedNote}</p>
		<ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-fg-muted" aria-label="Legend">
			<li class="flex items-center gap-2">
				<span class="ob-key-heat h-2.5 w-8 shrink-0 rounded-4" aria-hidden="true"></span>
				Resting orders: brighter = more size, relative to the largest level in view
			</li>
			<li class="flex items-center gap-2">
				<span class="ob-key-buy size-2.5 shrink-0 rounded-full" aria-hidden="true"></span>
				<span class="ob-key-sell size-2.5 shrink-0 rounded-full" aria-hidden="true"></span>
				Trades: filled = buy, ring = sell, larger = more value
			</li>
			<li class="flex items-center gap-2">
				<span class="ob-key-mid h-0.5 w-5 shrink-0" aria-hidden="true"></span>
				Line: mid price
			</li>
		</ul>
		<p class="text-xs text-fg-subtle">
			Right scale: price, with the current mid price tagged. Bottom scale: time before now. Up to {MAX_LEVELS} aggregated levels per side,
			{SIG_FIGS} significant figures. {coin} only; depth varies by market and orders can be cancelled. Not advice.
		</p>
	</div>
</div>

<script>
	import { TAB_CHANGE_EVENT } from "@/scripts/tabs";

	const root = document.querySelector<HTMLElement>("[data-open-book]");
	const tabs = root?.closest<HTMLElement>("[data-tabs]");
	if (root && tabs) {
		const panel = root.closest<HTMLElement>("[data-tabpanel]");
		tabs.addEventListener(TAB_CHANGE_EVENT, () => {
			if (panel?.hidden) return;
			import("@/scripts/open-book").then(({ startOpenBook }) => startOpenBook(root));
		});
	}
</script>
