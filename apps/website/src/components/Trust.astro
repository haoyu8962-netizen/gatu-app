---
import { APP_HOST, SITE_HOST } from "@/config/brand";

const pillars = [
	{
		title: "Self-custody",
		body: "Funds stay in your own Hyperliquid account and never pass through us. With email, a wallet created for your account signs your orders; with your own wallet, a trading key you approve for this browser session signs them.",
		icon: "key",
	},
	{
		title: "Onchain order book",
		body: "A real central limit order book, onchain — not an AMM, not a dark pool. Every order and fill is verifiable.",
		icon: "book",
	},
	{
		title: "Fees on the record",
		body: "Hyperliquid's trading fee, plus a 0.01% builder fee on perp orders and spot sells (TWAP orders carry none) — both charged by the protocol and shown on your fills.",
		icon: "receipt",
	},
];

const iconSvg: Record<string, string> = {
	key: '<circle cx="96" cy="164" r="52" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/><line x1="132" y1="128" x2="208" y2="52" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/><line x1="176" y1="84" x2="204" y2="112" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>',
	book: '<path d="M128,88a32,32,0,0,1,32-32h72V200H160a32,32,0,0,0-32,32" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/><path d="M24,200H96a32,32,0,0,1,32,32V88A32,32,0,0,0,96,56H24Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>',
	receipt: '<path d="M32,208V56a8,8,0,0,1,8-8H216a8,8,0,0,1,8,8V208l-32-16-32,16-32-16-32,16-32-16Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/><line x1="80" y1="104" x2="176" y2="104" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/><line x1="80" y1="136" x2="176" y2="136" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>',
};
---

<section id="security" class="border-b border-stroke-weaker">
	<div class="reveal mx-auto w-full max-w-5xl px-6 py-20 md:py-28">
		<div class="text-center">
			<span class="text-3xs uppercase tracking-uppercase text-fg-faint">Security</span>
			<h2 class="font-display mt-3 text-xl md:text-2xl tracking-display">Verify, don't trust.</h2>
			<p class="mt-4 mx-auto max-w-md text-sm text-fg-muted leading-relaxed">
				Your funds, orders, and fees all live on Hyperliquid's public ledger, so you can check every one of them.
			</p>
		</div>

		<div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-px bg-stroke-weaker rounded-xs overflow-hidden border border-stroke-weak">
			{pillars.map((p) => (
				<div class="group bg-surface p-6 md:p-8">
					<div class="inline-flex h-9 w-9 items-center justify-center rounded-xs bg-fill-weaker text-fg-muted transition-colors duration-200 group-hover:text-signal">
						<svg width="16" height="16" viewBox="0 0 256 256" aria-hidden="true" set:html={iconSvg[p.icon]} />
					</div>
					<div class="mt-4 text-sm font-medium">{p.title}</div>
					<p class="mt-1.5 text-xs text-fg-muted leading-relaxed">{p.body}</p>
				</div>
			))}
		</div>

		<p class="mt-8 text-center text-xs text-fg-muted leading-relaxed">
			We will never ask for your private key, seed phrase, verification code or password. The official addresses are
			{SITE_HOST} and {APP_HOST}.
		</p>
	</div>
</section>
