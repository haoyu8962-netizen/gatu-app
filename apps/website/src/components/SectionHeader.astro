---
interface Props {
	label: string;
	titleId?: string;
}

const { label, titleId } = Astro.props;
const hasIntro = Astro.slots.has("intro");
---

<div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end lg:gap-8">
	<div class:list={[hasIntro ? "lg:col-span-7" : "lg:col-span-12"]}>
		<p class="label">{label}</p>
		<h2 id={titleId} class="mt-5 max-w-4xl text-h2 font-medium text-balance">
			<slot />
		</h2>
	</div>
	{hasIntro && (
		<div class="text-md text-fg-muted lg:col-span-5 lg:pb-2">
			<slot name="intro" />
		</div>
	)}
</div>
