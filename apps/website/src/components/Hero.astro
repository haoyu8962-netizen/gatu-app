---
import desktopScreenshot from "@/assets/terminal-desktop.jpeg";
import mobileScreenshot from "@/assets/terminal-mobile.jpeg";
import capture from "@/assets/terminal-capture.json";
import { APP_HOST, BRAND_NAME } from "@/config/brand";
import { formatUtcTimestamp, joinNames, RESTRICTED_SHORT, RISK_PATH, RISK_SENTENCE, TERMS_RESTRICTED_PATH } from "@/config/copy";
import { getDeployerFullNames, getFeaturedMarkets, getHeroMarkets } from "@/lib/markets/structure";
import { terminalTradeUrl } from "@/lib/terminal-links";

const heroMarkets = getHeroMarkets();
const heroDeployers = joinNames(getDeployerFullNames(getFeaturedMarkets().map((market) => market.coin)));
const startUrl = terminalTradeUrl("BTC", "hero_cta");
function listSeparator(index: number, count: number): string {
	if (index === 0) return "";
	return index === count - 1 ? " and " : ", ";
}

const caption = `Screenshot of ${APP_HOST}, signed out · ${formatUtcTimestamp(capture.capturedAt)}`;
---

<section class="relative overflow-hidden border-b border-stroke-weaker">
	<div class="absolute inset-0 bg-grid opacity-40 [mask-image:radial-gradient(ellipse_at_center,black,transparent_75%)]"></div>

	<div class="relative mx-auto w-full max-w-6xl px-5 sm:px-6 pt-14 pb-16 md:pt-24 md:pb-24">
		<div class="flex flex-col items-center text-center">
			<p class="text-2xs uppercase tracking-uppercase text-fg-faint">Independent trading terminal for Hyperliquid</p>

			<h1 class="font-display mt-6 md:mt-7 max-w-3xl text-3xl md:text-4xl leading-[1.02] tracking-display">
				Every market on <span class="text-signal">Hyperliquid</span>.<br />
				One account, 24/7.
			</h1>

			<p class="mt-5 md:mt-6 max-w-2xl text-sm md:text-base text-fg-muted leading-relaxed">
				Sign in with email or your own wallet. Trade perpetuals on crypto, US stocks, indices, commodities, FX and
				pre-IPO companies such as {heroMarkets.map((market, index) => [
					listSeparator(index, heroMarkets.length),
					<a
						href={terminalTradeUrl(market.coin, "hero_market")}
						class="text-fg underline underline-offset-4 decoration-stroke-strong hover:decoration-fg transition-colors duration-150"
					>{market.name}</a>,
				])}, plus spot.
			</p>

			<div data-cta-group class="mt-8 md:mt-10 flex w-full max-w-2xl flex-col items-center">
				<div class="flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center">
					<a
						href={startUrl}
						class="press inline-flex h-11 items-center justify-center gap-2 rounded-xs bg-action px-5 text-sm font-medium text-on-action transition-[background-color,transform] duration-200 hover:bg-action-hover active:bg-action-active"
					>
						Start trading
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
							<path d="M3 9l6-6M5 3h4v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
					<a
						href="#markets"
						class="press inline-flex h-11 items-center justify-center gap-2 rounded-xs border border-stroke-weak px-5 text-sm text-fg-muted hover:text-fg hover:border-stroke-strong transition-colors duration-200"
					>
						Browse markets ↓
					</a>
				</div>

				<p class="mt-6 text-xs md:text-sm text-fg-muted leading-relaxed">
					{RISK_SENTENCE} Stock and pre-IPO markets are perpetuals run by third-party deployers such as {heroDeployers},
					not shares; outside exchange hours their prices come from the deployer.
					<a href={RISK_PATH} class="text-fg underline underline-offset-2 hover:text-fg-muted transition-colors duration-150">Risk disclosure →</a>
				</p>

				<p class="mt-3 text-2xs text-fg-subtle">
					Funds stay in your own Hyperliquid account · 0.01% builder fee ·
					<a href={TERMS_RESTRICTED_PATH} class="underline underline-offset-2 hover:text-fg-muted transition-colors duration-150">{RESTRICTED_SHORT}</a>
				</p>
			</div>
		</div>

		<figure class="relative mx-auto mt-12 md:mt-16 max-w-5xl">
			<div class="overflow-hidden rounded-12 border border-stroke-weak bg-surface shadow-2xl">
				<picture>
					<source
						media="(min-width: 640px)"
						srcset={desktopScreenshot.src}
						width={desktopScreenshot.width}
						height={desktopScreenshot.height}
					/>
					<img
						src={mobileScreenshot.src}
						alt={`${BRAND_NAME} terminal, signed out, on BTC with the market selector open at Traditional Finance, Pre-IPO`}
						class="block w-full h-auto bg-background"
						loading="eager"
						decoding="async"
						width={mobileScreenshot.width}
						height={mobileScreenshot.height}
					/>
				</picture>
			</div>
			<figcaption class="mt-3 text-center text-2xs text-fg-faint">{caption}</figcaption>
		</figure>
	</div>
</section>
