---
import desktopAvif from "@/assets/terminal-desktop.avif";
import desktopWebp from "@/assets/terminal-desktop.webp";
import desktopScreenshot from "@/assets/terminal-desktop.jpeg";
import mobileAvif from "@/assets/terminal-mobile.avif";
import mobileWebp from "@/assets/terminal-mobile.webp";
import mobileScreenshot from "@/assets/terminal-mobile.jpeg";
import capture from "@/assets/terminal-capture.json";
import { APP_HOST, BRAND_NAME } from "@/config/brand";
import {
	formatUtcTimestamp,
	HERO_HEADLINE,
	HERO_REEL_WORDS,
	joinNames,
	RISK_PATH,
	RISK_SENTENCE,
} from "@/config/copy";
import { getDeployerFullNames, getFeaturedMarkets, getHeroMarkets } from "@/lib/markets/structure";
import { terminalTradeUrl } from "@/lib/terminal-links";
import envelopeIcon from "@phosphor-icons/core/assets/regular/envelope-simple.svg?raw";
import translateIcon from "@phosphor-icons/core/assets/regular/translate.svg?raw";
import devicesIcon from "@phosphor-icons/core/assets/regular/devices.svg?raw";
import ButtonLink from "./ButtonLink.astro";
import OpenBook from "./OpenBook.astro";

const heroMarkets = getHeroMarkets();
const heroMarketDeployers = joinNames(getDeployerFullNames(heroMarkets.map((market) => market.coin)));
const heroDeployers = joinNames(getDeployerFullNames(getFeaturedMarkets().map((market) => market.coin)));
const startUrl = terminalTradeUrl("BTC", "hero_cta");
// Review 2026-10-26 item 6: three reasons, each checked against the terminal; since the 2026-10-27 review they sit
// above the preview with the Pre-IPO links, so the first screen reads as text and the screenshot starts at the fold
// (apps/terminal/src/config/i18n.ts lists the six languages; the terminal switches to its mobile layout at 1000px).
const benefits = [
	{ title: "Email or wallet", desc: "Start with an email address, or connect the wallet you already use.", icon: envelopeIcon },
	{
		title: "Six languages, including right-to-left",
		desc: "English, 简体中文, हिन्दी, Español, Français and العربية.",
		icon: translateIcon,
	},
	{
		title: "Desktop and mobile trading",
		desc: "A full desktop workspace and a dedicated mobile layout you can install as an app.",
		icon: devicesIcon,
	},
];

function inlineIcon(svg: string, size: number): string {
	return svg.replace("<svg ", `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
}

const caption = `Screenshot of ${APP_HOST}, signed out · ${formatUtcTimestamp(capture.capturedAt)}`;
const [firstLine] = HERO_HEADLINE.split(" on ");
if (HERO_REEL_WORDS[0] !== firstLine || HERO_REEL_WORDS.at(-1) !== firstLine) {
	throw new Error("the hero reel must start and end on the headline's first words");
}
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
	<div class="hero-ambient" aria-hidden="true"></div>
	<div class="mx-auto w-full max-w-site px-5 sm:px-8">
		<div class="pt-6 pb-10 sm:pt-12 md:pt-16 md:pb-14 lg:flex lg:min-h-[min(calc(100svh-4rem),64rem)] lg:flex-col">
			<div class="grid grid-cols-1 gap-5 sm:gap-10 lg:my-auto xl:grid-cols-12 xl:items-end xl:gap-x-10">
				<div class="xl:col-span-8">
					<p class="edge edge-panel inline-flex items-center rounded-full px-3 py-1 font-mono text-3xs tracking-normal text-fg-muted uppercase sm:px-3.5 sm:py-1.5 sm:text-2xs sm:tracking-label">
						Independent trading terminal for Hyperliquid
					</p>

					<h1 id="hero-title" class="mt-4 text-display font-medium sm:mt-6">
						<span class="sr-only">{HERO_HEADLINE}</span>
						<span aria-hidden="true" class="block">
							<span class="reel text-marketing-accent">
								<span class="reel-track">{HERO_REEL_WORDS.map((word) => <span>{word}</span>)}</span>
							</span>
							on Hyperliquid.
							<span class="hero-h1-secondary text-fg-subtle">One account, 24/7.</span>
						</span>
					</h1>
				</div>

				<div data-cta-group class="flex max-w-xl flex-col xl:col-span-4 xl:max-w-none xl:pb-1">
					<p class="text-base text-fg-muted sm:text-md">
						Trade crypto, stock and pre-IPO perpetuals on Hyperliquid. Sign in with email or your wallet.
						<span class="text-fg">Your funds stay in your own Hyperliquid account.</span>
					</p>
					<div class="mt-6 grid grid-cols-1 gap-3 min-[400px]:grid-cols-2 sm:flex sm:flex-row sm:flex-wrap">
						<ButtonLink href={startUrl} variant="primary" size="lg" icon="external">Start trading</ButtonLink>
						<ButtonLink href="#markets" variant="secondary" size="lg" icon="down">Browse markets</ButtonLink>
					</div>

					<p class="mt-4 text-sm/5 text-fg-muted sm:mt-5" data-hero-risk>
						{RISK_SENTENCE} Stock and pre-IPO markets are perpetuals from deployers such as {heroDeployers}, not shares;
						outside exchange hours, prices come from the deployer.
						<a href={RISK_PATH} class="whitespace-nowrap text-fg underline underline-offset-2 hover:text-fg-muted">Risk disclosure</a>
					</p>
				</div>
			</div>

			<div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-6 border-t border-stroke-weaker pt-8 md:mt-14 xl:grid-cols-4">
				<div>
					<p class="text-sm text-balance text-fg-muted" id="hero-markets-label">Pre-IPO perpetuals <span class="whitespace-nowrap">by {heroMarketDeployers}</span> <span class="whitespace-nowrap">— not shares</span></p>
					<div class="mt-3 flex flex-wrap gap-2" role="group" aria-labelledby="hero-markets-label">
						{heroMarkets.map((market) => (
							<ButtonLink href={terminalTradeUrl(market.coin, "hero_market")} variant="secondary" size="sm" icon="external">
								{market.name}<span class="sr-only"> pre-IPO perpetual by {market.deployerFullName}, not shares</span>
							</ButtonLink>
						))}
					</div>
				</div>
				<ul class="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-3 xl:col-span-3" aria-label={`Why ${BRAND_NAME}`}>
					{benefits.map((benefit) => (
						<li class="flex gap-3">
							<span class="mt-0.5 shrink-0 text-marketing-accent" set:html={inlineIcon(benefit.icon, 20)} />
							<span class="flex flex-col">
								<span class="text-base font-medium text-fg">{benefit.title}</span>
								<span class="mt-0.5 text-sm text-fg-muted">{benefit.desc}</span>
							</span>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="surface-dark edge relative mb-12 overflow-hidden rounded-24 shadow-window md:mb-16" data-tabs data-preview>
			<h2 class="sr-only">Product preview</h2>
			<div class="flex items-center justify-between gap-3 border-b border-stroke-weaker px-2 py-2 sm:px-3">
				<div role="tablist" aria-label="Preview" data-tablist class="flex gap-1 rounded-full bg-fill-weak p-1">
					<button
						type="button"
						role="tab"
						id="preview-tab-terminal"
						aria-controls="preview-terminal"
						aria-selected="true"
						class="preview-tab press inline-flex min-h-11 items-center rounded-full px-4 text-sm text-fg-subtle hover:text-fg sm:min-h-8"
					>
						Terminal
					</button>
					<button
						type="button"
						role="tab"
						id="preview-tab-live"
						aria-controls="preview-live"
						aria-selected="false"
						tabindex="-1"
						class="preview-tab press inline-flex min-h-11 items-center rounded-full px-4 text-sm text-fg-subtle hover:text-fg sm:min-h-8"
					>
						Live market
					</button>
				</div>
				<p class="hidden font-mono text-xs text-fg-subtle sm:block">Real interface · public data</p>
			</div>

			<div id="preview-terminal" role="tabpanel" aria-labelledby="preview-tab-terminal" data-tabpanel>
				<figure>
					<div class="bg-window">
						<picture>
							<source media="(min-width: 640px)" type="image/avif" srcset={desktopAvif.src} width={desktopAvif.width} height={desktopAvif.height} />
							<source media="(min-width: 640px)" type="image/webp" srcset={desktopWebp.src} width={desktopWebp.width} height={desktopWebp.height} />
							<source
								media="(min-width: 640px)"
								srcset={desktopScreenshot.src}
								width={desktopScreenshot.width}
								height={desktopScreenshot.height}
							/>
							<source type="image/avif" srcset={mobileAvif.src} width={mobileAvif.width} height={mobileAvif.height} />
							<source type="image/webp" srcset={mobileWebp.src} width={mobileWebp.width} height={mobileWebp.height} />
							<img
								src={mobileScreenshot.src}
								alt={`${BRAND_NAME} terminal, signed out, on the BTC perpetual: order form and order book, with the price chart on wider screens`}
								class="block h-auto w-full bg-window"
								loading="eager"
								decoding="async"
								width={mobileScreenshot.width}
								height={mobileScreenshot.height}
							/>
						</picture>
					</div>
					<figcaption class="border-t border-stroke-weaker px-4 py-3 font-mono text-xs text-fg-subtle sm:px-5">{caption}</figcaption>
				</figure>
			</div>
			<div id="preview-live" role="tabpanel" aria-labelledby="preview-tab-live" data-tabpanel data-requires-js hidden>
				<OpenBook />
			</div>
		</div>
	</div>
</section>
