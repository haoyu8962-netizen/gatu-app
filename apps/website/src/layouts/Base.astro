---
import "../styles/global.css";
import faviconUrl from "../../../../brand/web/favicon.svg?url";
import { Font } from "astro:assets";
import { APP_URL } from "@/config/brand";
import { SEO_DEFAULTS } from "@/config/seo";
import { cspHash, JS_CLASS_SCRIPT } from "@/lib/csp";
import { MOTION_ROOT_RULE } from "@/lib/motion";
import { THEME_QUERY_SCRIPT } from "@/lib/theme";
import { resolveSeo, type PageSeo } from "@/lib/seo";

interface Props extends PageSeo {
	jsonLd?: unknown | unknown[];
}

const { jsonLd, ...seoOptions } = Astro.props;

const seo = resolveSeo({
	path: Astro.url.pathname,
	...seoOptions,
});

Astro.csp?.insertScriptHash(cspHash(JS_CLASS_SCRIPT));
Astro.csp?.insertScriptHash(cspHash(THEME_QUERY_SCRIPT));
Astro.csp?.insertStyleHash(cspHash(MOTION_ROOT_RULE));

const schemas = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content={SEO_DEFAULTS.themeColor} />
		<meta name="color-scheme" content="light" />
		<Font cssVariable="--font-plex-sans" preload />
		<Font cssVariable="--font-plex-mono" />
		<style is:inline data-motion-tokens set:html={MOTION_ROOT_RULE} />
		<script is:inline set:html={JS_CLASS_SCRIPT} />
		<script is:inline data-theme-query set:html={THEME_QUERY_SCRIPT} />
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" sizes="any" href={faviconUrl} />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<title>{seo.title}</title>
		<meta name="description" content={seo.description} />
		<meta name="keywords" content={seo.keywords} />
		<meta name="author" content={SEO_DEFAULTS.siteName} />
		<meta
			name="robots"
			content={seo.noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"}
		/>

		<meta property="og:type" content={seo.ogType} />
		<meta property="og:site_name" content={SEO_DEFAULTS.siteName} />
		<meta property="og:title" content={seo.ogTitle} />
		<meta property="og:description" content={seo.description} />
		{seo.canonical && <meta property="og:url" content={seo.canonical} />}
		<meta property="og:locale" content={SEO_DEFAULTS.locale} />
		<meta property="og:image" content={seo.ogImage} />
		<meta property="og:image:alt" content={seo.ogImageAlt} />
		<meta property="og:image:width" content={String(SEO_DEFAULTS.ogImageWidth)} />
		<meta property="og:image:height" content={String(SEO_DEFAULTS.ogImageHeight)} />

		{seo.ogType === "article" && seo.publishedTime && (
			<meta property="article:published_time" content={seo.publishedTime} />
		)}
		{seo.ogType === "article" && seo.modifiedTime && (
			<meta property="article:modified_time" content={seo.modifiedTime} />
		)}
		{seo.ogType === "article" && seo.author && <meta property="article:author" content={seo.author} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seo.ogTitle} />
		<meta name="twitter:description" content={seo.description} />
		<meta name="twitter:image" content={seo.ogImage} />
		<meta name="twitter:image:alt" content={seo.ogImageAlt} />

		{seo.canonical && <link rel="canonical" href={seo.canonical} />}
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="preconnect" href={APP_URL} />
		<link rel="dns-prefetch" href={APP_URL} />

		{schemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}
	</head>
	<body class="flex min-h-screen flex-col bg-background text-fg antialiased">
		<slot />
		<script>
			import { wireTabs } from "@/scripts/tabs";

			wireTabs(document);
		</script>
	</body>
</html>
