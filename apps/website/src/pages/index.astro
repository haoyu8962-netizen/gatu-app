---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import LiveMarkets from "@/components/LiveMarkets.astro";
import Markets from "@/components/Markets.astro";
import Features from "@/components/Features.astro";
import Fees from "@/components/Fees.astro";
import Trust from "@/components/Trust.astro";
import Faq from "@/components/Faq.astro";
import FactsBlock from "@/components/FactsBlock.astro";
import Footer from "@/components/Footer.astro";
import { FAQS } from "@/config/faq";
import { assertMarketStructureCurrent } from "@/lib/markets/structure";
import { ROUTE_SEO } from "@/config/seo";
import { faqSchema, organizationSchema, softwareApplicationSchema, websiteSchema } from "@/lib/seo";

assertMarketStructureCurrent();

const seo = ROUTE_SEO.HOME;
const jsonLd = [organizationSchema(), websiteSchema(), softwareApplicationSchema(), faqSchema(FAQS)];
---

<Base
	title={seo.title}
	fullTitle={seo.fullTitle}
	ogTitle={seo.ogTitle}
	description={seo.description}
	path={seo.path}
	keywords={seo.keywords}
	jsonLd={jsonLd}
>
	<Nav />
	<main>
		<Hero />
		<div data-cta-group>
			<LiveMarkets />
			<Markets />
		</div>
		<Features />
		<Fees />
		<Trust />
		<Faq />
		<FactsBlock />
	</main>
	<Footer livePause />
</Base>
