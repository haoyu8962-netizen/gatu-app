---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Ticker from "@/components/Ticker.astro";
import Markets from "@/components/Markets.astro";
import FeatureSpeed from "@/components/FeatureSpeed.astro";
import Features from "@/components/Features.astro";
import Fees from "@/components/Fees.astro";
import Trust from "@/components/Trust.astro";
import Faq from "@/components/Faq.astro";
import Footer from "@/components/Footer.astro";
import { FAQS } from "@/config/faq";
import { ROUTE_SEO } from "@/config/seo";
import { faqSchema, organizationSchema, softwareApplicationSchema, websiteSchema } from "@/lib/seo";

const seo = ROUTE_SEO.HOME;
const jsonLd = [organizationSchema(), websiteSchema(), softwareApplicationSchema(), faqSchema(FAQS)];
---

<Base
	title={seo.title}
	fullTitle={seo.fullTitle}
	description={seo.description}
	path={seo.path}
	keywords={seo.keywords}
	jsonLd={jsonLd}
>
	<Nav />
	<main>
		<Hero />
		<Ticker />
		<Markets />
		<FeatureSpeed />
		<Features />
		<Fees />
		<Trust />
		<Faq />
	</main>
	<Footer />
</Base>
