---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { blogPostingSchema, breadcrumbSchema } from "@/lib/seo";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id.replace(/\.md$/, "") },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const slug = post.id.replace(/\.md$/, "");
const publishedTime = post.data.date.toISOString();
const modifiedTime = post.data.updated?.toISOString();

const jsonLd = [
	blogPostingSchema({
		title: post.data.title,
		description: post.data.description,
		slug,
		publishedTime,
		modifiedTime,
		author: post.data.author,
	}),
	breadcrumbSchema([
		{ name: "Home", path: "/" },
		{ name: "Blog", path: "/blog/" },
		{ name: post.data.title, path: `/blog/${slug}/` },
	]),
];

const formatter = new Intl.DateTimeFormat("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<Base
	title={post.data.title}
	description={post.data.description}
	path={`/blog/${slug}/`}
	ogType="article"
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	author={post.data.author}
	jsonLd={jsonLd}
	noIndex
>
	<Nav />
	<main>
		<article class="mx-auto w-full max-w-2xl px-5 sm:px-6 pt-16 pb-20 md:pt-24 md:pb-28">
			<a
				href="/blog/"
				class="inline-flex items-center gap-1.5 text-2xs uppercase tracking-uppercase text-fg-faint hover:text-fg-muted transition-colors duration-200"
			>
				<svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<path d="M7.5 9l-3-3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				Back to blog
			</a>

			<header class="mt-8 border-b border-stroke-weaker pb-8">
				<time
					datetime={publishedTime}
					class="text-2xs uppercase tracking-uppercase text-fg-faint tabular"
				>
					{formatter.format(post.data.date)}
				</time>
				<h1 class="mt-3 text-2xl md:text-3xl font-medium tracking-display leading-[1.1]">
					{post.data.title}
				</h1>
				<p class="mt-4 text-sm md:text-base text-fg-muted leading-relaxed">
					{post.data.description}
				</p>
			</header>

			<div class="prose-body mt-8 text-sm md:text-base text-fg-weak leading-relaxed">
				<Content />
			</div>
		</article>
	</main>
	<Footer />
</Base>
