{
	"name": "@sairn/website",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev --port 3010",
		"build": "astro build",
		"preview": "astro preview --port 3010",
		"test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
		"test:dist": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/built/*.test.mjs",
		"markets:snapshot": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/markets-snapshot.mjs",
		"markets:icons": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/market-icons.mjs",
		"terminal:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-terminal-release.mjs",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"@fontsource-variable/ibm-plex-sans": "5.2.8",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@phosphor-icons/core": "2.1.1",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.4.2",
		"big.js": "7.0.1",
		"tailwindcss": "4.3.3"
	},
	"devDependencies": {
		"@types/big.js": "6.2.2",
		"jsdom": "29.0.2"
	}
}
