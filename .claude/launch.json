{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "terminal",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gatu/terminal", "exec", "vite", "dev", "--port", "3005", "--strictPort"],
      "port": 3005
    },
    {
      "name": "terminal-pairing",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_MOBILE_PAIRING_CREATE_ENABLED=true",
        "VITE_MOBILE_PAIRING_IMPORT_ENABLED=true",
        "pnpm",
        "--filter",
        "@gatu/terminal",
        "exec",
        "vite",
        "dev",
        "--port",
        "3005",
        "--strictPort"
      ],
      "port": 3005
    },
    {
      "name": "terminal-inspect",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gatu/terminal", "exec", "vite", "dev", "--port", "3015", "--strictPort"],
      "port": 3015
    },
    {
      "name": "terminal-3006",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gatu/terminal", "exec", "vite", "dev", "--port", "3006", "--strictPort", "--host", "0.0.0.0"],
      "port": 3006
    },
    {
      "name": "terminal-spa",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/serve-spa-static.mjs", "apps/terminal/.output/public", "--port", "3030"],
      "port": 3030
    },
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gatu/website", "dev"],
      "port": 3010
    },
    {
      "name": "design-handoff",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3020",
        "--bind",
        "127.0.0.1",
        "--directory",
        "designs"
      ],
      "port": 3020
    }
  ]
}
