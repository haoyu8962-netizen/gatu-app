{
	"name": "hypeterminal",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.21.0",
	"engines": {
		"node": ">=22.15.0"
	},
	"scripts": {
		"dev": "pnpm --filter @gatu/terminal dev",
		"dev:browser": "pnpm --filter @gatu/terminal dev:browser",
		"build": "pnpm --filter @gatu/terminal build",
		"serve": "pnpm --filter @gatu/terminal serve",
		"test": "pnpm og:check && pnpm --filter @gatu/terminal test && pnpm --filter @gatu/website test && node --test tests/brand-cross-app.test.mjs",
		"test:brand": "pnpm og:check && pnpm --dir apps/terminal exec vitest run src/lib/tests/brand-semantics-contract.test.ts src/lib/tests/gatu-logo.test.tsx src/lib/tests/mobile-app-shell-skeleton.test.tsx src/lib/tests/mobile-header-brand.test.tsx src/lib/tests/seo.test.ts && pnpm --filter @gatu/website test && node --test tests/brand-cross-app.test.mjs",
		"typecheck": "pnpm --filter @gatu/hl-react typecheck && pnpm --filter @gatu/ui typecheck && pnpm --filter @gatu/terminal typecheck",
		"diagnostics:browser": "node scripts/browser-diagnostics.js",
		"memory:capture": "node scripts/capture-worklog.mjs",
		"memory:index": "node scripts/work-memory.mjs --write",
		"memory:check": "node scripts/work-memory.mjs --check",
		"memory:test": "node --test scripts/work-memory.test.mjs",
		"validate:mobile-device": "node scripts/validate-mobile-phone-access-device-validation.js",
		"test:mobile-device-validator": "node --test scripts/validate-mobile-phone-access-device-validation.test.js",
		"template:mobile-device": "node scripts/validate-mobile-phone-access-device-validation.js --print-template",
		"init:mobile-device": "node scripts/validate-mobile-phone-access-device-validation.js --init-missing",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"fix": "biome check --write",
		"i18n:extract": "pnpm --filter @gatu/terminal i18n:extract",
		"i18n:compile": "pnpm --filter @gatu/terminal i18n:compile",
		"og:generate": "node scripts/generate-og-cards.mjs --generate",
		"og:check": "node scripts/generate-og-cards.mjs --check",
		"asset-info:generate": "node scripts/generate-spot-asset-info.mjs",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@ai-hero/sandcastle": "0.5.6",
		"@biomejs/biome": "2.2.4",
		"@commitlint/cli": "20.3.1",
		"@commitlint/config-conventional": "20.3.1",
		"@playwright/test": "1.59.1",
		"es-module-lexer": "1.7.0",
		"lefthook": "1.11.0",
		"typescript": "5.7.2"
	}
}
