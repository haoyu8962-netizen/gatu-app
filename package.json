{
	"name": "sairn",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.21.0",
	"engines": {
		"node": ">=22.15.0"
	},
	"scripts": {
		"dev": "pnpm --filter @sairn/terminal dev",
		"dev:browser": "pnpm --filter @sairn/terminal dev:browser",
		"build": "pnpm --filter @sairn/terminal build",
		"serve": "pnpm --filter @sairn/terminal serve",
		"test": "pnpm og:check && pnpm --filter @sairn/terminal test && pnpm --filter @sairn/website test && node --test tests/brand-cross-app.test.mjs",
		"test:brand": "pnpm brand:check && pnpm og:check && pnpm --dir apps/terminal exec vitest run src/lib/tests/brand-semantics-contract.test.ts src/lib/tests/brand-logo.test.tsx src/lib/tests/status-motion-contract.test.ts src/lib/tests/status-glyph.test.tsx src/lib/tests/root-startup-fallback.test.tsx src/lib/tests/mobile-header-brand.test.tsx src/lib/tests/seo.test.ts && pnpm --filter @sairn/website test && node --test tests/brand-cross-app.test.mjs",
		"typecheck": "pnpm --filter @sairn/hl-react typecheck && pnpm --filter @sairn/ui typecheck && pnpm --filter @sairn/terminal typecheck",
		"diagnostics:browser": "node scripts/browser-diagnostics.js",
		"memory:capture": "node scripts/capture-worklog.mjs",
		"memory:index": "node scripts/work-memory.mjs --write",
		"memory:check": "node scripts/work-memory.mjs --check",
		"memory:test": "node --test scripts/work-memory.test.mjs",
		"test:cloudfront": "node --experimental-strip-types --test deploy/cloudfront/*.test.mjs deploy/cloudfront/functions/*.test.mjs",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"fix": "biome check --write",
		"i18n:extract": "pnpm --filter @sairn/terminal i18n:extract",
		"i18n:compile": "pnpm --filter @sairn/terminal i18n:compile",
		"brand:check": "node scripts/brand.mjs --check",
		"brand:sync": "node scripts/brand.mjs --sync",
		"brand:derive-icons": "node scripts/brand-derive-icons.mjs",
		"brand:export-motion": "node scripts/brand-export-motion.mjs --write",
		"og:generate": "node scripts/generate-og-cards.mjs --generate",
		"og:check": "node scripts/generate-og-cards.mjs --check",
		"asset-info:generate": "node scripts/generate-spot-asset-info.mjs",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@ai-hero/sandcastle": "0.5.6",
		"@biomejs/biome": "2.2.4",
		"@commitlint/cli": "20.3.1",
		"@commitlint/config-conventional": "20.3.1",
		"@playwright/test": "1.59.1",
		"es-module-lexer": "1.7.0",
		"lefthook": "1.11.0",
		"typescript": "5.7.2"
	}
}
